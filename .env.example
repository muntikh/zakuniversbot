# ============================================================
# Zakaria VPN Bot — Environment Configuration
# Copy this to .env and fill in your real values
# ============================================================

# --- Telegram ---
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# Comma-separated Telegram IDs of bot owners (never store in DB)
OWNER_IDS=123456789,987654321

# --- PasarGuard / Marzban ---
PANEL_URL=https://your-marzban-panel.com
PANEL_API_KEY=pg_key_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PANEL_USERNAME=your_panel_admin_username
PANEL_PASSWORD=your_panel_admin_password

# --- Database ---
# SQLite (default for local dev):
DATABASE_URL=sqlite+aiosqlite:///./bot.db
# PostgreSQL (production, uncomment and set):
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/zakbot

# --- Bot Behaviour ---
# Comma-separated channel IDs/usernames for mandatory membership
MANDATORY_CHANNELS=
# Minutes before an unpaid order auto-expires
ORDER_EXPIRY_MINUTES=30
# Max free trial accounts per Telegram user (1 = one-time)
FREE_TRIAL_LIMIT=1

# --- Logging ---
LOG_LEVEL=INFO
